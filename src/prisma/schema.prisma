// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}
// ==========================
// ENUMS
// ==========================

enum UserRole {
  ADMIN
  HOST
  CUSTOMER
}

enum PropertyStatus {
  DRAFT
  PENDING_APPROVAL  // Admin review required
  ACTIVE
  INACTIVE
  BLOCKED
  REJECTED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED  // For reviews & payouts
  REFUNDED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  PAYMENT_FAILED
}

// ==========================
// USER & AUTH
// ==========================

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  phone         String?  @unique  // Required for Kuwait/MENA region
  passwordHash  String
  role          UserRole
  isVerified    Boolean  @default(false)

  // Host KYC (required for production)
  fullName      String?
  nationalId    String?  // Civil ID for Kuwait
  isKycApproved Boolean  @default(false)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions      Session[]
  properties    Property[]
  bookings      Booking[]
  subscriptions Subscription[]
  auditLogs     AuditLog[]
  reviews       Review[]
  wishlist      Wishlist[]
  hostPayout    HostPayout?
}

// Tracks login sessions (refresh tokens)
model Session {
  id               String   @id @default(uuid())
  userId           String
  refreshTokenHash String
  expiresAt        DateTime

  ipAddress        String?
  userAgent        String?

  createdAt        DateTime @default(now())

  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt]) // For session cleanup cron job
}

// ==========================
// PROPERTY
// ==========================

model Property {
  id               String         @id @default(uuid())
  hostId           String

  title            String
  titleAr          String?        // Arabic title for i18n
  description      String         @db.Text
  descriptionAr    String?        @db.Text // Arabic description

  // Property Type
  propertyType     String         @default("APARTMENT") // APARTMENT, VILLA, HOTEL, RESORT, STUDIO, etc.

  location         String
  locationAr       String?        // Arabic location name
  address          String?        // Full street address
  addressAr        String?        // Arabic address
  city             String?        // City name
  cityAr           String?        // Arabic city name
  district         String?        // District/neighborhood
  districtAr       String?        // Arabic district
  postalCode       String?        // Postal/ZIP code
  country          String         @default("Kuwait")
  countryCode      String         @default("KW") // ISO country code
  latitude         Float?
  longitude        Float?
  
  // Nearby landmarks (booking.com style)
  distanceToCenter Float?         // km to city center
  nearestAirport   String?        // e.g., "Kuwait International Airport"
  airportDistance  Float?         // km to airport

  // Pricing
  basePrice        Decimal        // Store in smallest unit (fils for KWD)
  currency         String         @default("KWD") // ISO: KWD, USD, SAR

  // Capacity Management (Agoda/Booking.com style)
  baseGuests       Int            // Base number of guests included in basePrice
  maxGuests        Int            // Maximum capacity
  extraGuestPrice  Decimal?       // Additional charge per extra guest

  // Property Details
  bedrooms         Int            @default(1)
  bathrooms        Int            @default(1)
  beds             Int            @default(1)
  areaSize         Int?           // Square meters
  floor            Int?           // Floor number for apartments

  // Check-in/out times
  checkInTime      String?        @default("14:00")
  checkOutTime     String?        @default("11:00")

  // Ratings & Reviews
  averageRating    Float?         @default(0)
  reviewCount      Int            @default(0)

  status           PropertyStatus @default(DRAFT)
  adminNotes       String?        // Rejection reason or notes

  // Additional features
  featured         Boolean        @default(false)
  instantBooking   Boolean        @default(false)

  // SEO & discoverability
  slug             String?        @unique
  viewCount        Int            @default(0)

  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  host             User           @relation(fields: [hostId], references: [id])
  images           PropertyImage[]
  bookings         Booking[]
  amenities        PropertyAmenity[]
  reviews          Review[]
  blockedDates     BlockedDate[]
  roomTypes        RoomType[]
  wishlist         Wishlist[]

  @@index([hostId])
  @@index([status])
  @@index([slug])
  @@index([propertyType])
  @@index([averageRating])
}

// Property images (stored in R2 / S3)
model PropertyImage {
  id         String   @id @default(uuid())
  propertyId String
  imageUrl  String
  order     Int

  property  Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
}

// ==========================
// ROOM TYPES & PACKAGES (Booking.com style)
// ==========================

model RoomType {
  id          String   @id @default(uuid())
  propertyId  String
  
  name        String   // e.g., "Deluxe Room", "Standard Studio"
  nameAr      String?
  description String?  @db.Text
  
  // Room specifications
  bedType     String   // e.g., "1 double bed", "2 single beds", "1 king bed"
  bedCount    Int      @default(1)
  roomSize    Int?     // Square meters
  maxGuests   Int      @default(2)
  
  // Base pricing (can be overridden by packages)
  basePrice   Decimal
  
  // Room features/amenities (JSON array of amenity IDs or names)
  features    String?  @db.Text // JSON: ["Air conditioning", "Private bathroom", "Flat-screen TV"]
  
  isActive    Boolean  @default(true)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  packages    RoomPackage[]
  bookings    Booking[]
  
  @@index([propertyId])
  @@index([isActive])
}

model RoomPackage {
  id              String   @id @default(uuid())
  roomTypeId      String
  
  name            String   // e.g., "Best Deal", "Free Cancellation", "Non-refundable"
  nameAr          String?
  
  // Pricing
  originalPrice   Decimal? // Struck-through price for showing discounts
  finalPrice      Decimal  // Actual price customer pays
  discountPercent Int?     // e.g., 53 for "53% off"
  
  // Deal badges
  isLimitedTime   Boolean  @default(false)
  dealLabel       String?  // e.g., "Limited-time Deal", "Early Bird"
  
  // Cancellation policy
  freeCancellation         Boolean  @default(false)
  cancellationDeadline     Int?     // Hours before check-in
  cancellationDeadlineText String?  // e.g., "before 11 February 2026"
  isRefundable            Boolean  @default(true)
  
  // Payment options
  prepaymentRequired Boolean  @default(false) // "Pay before arrival"
  noCreditCard       Boolean  @default(false) // "No credit card needed"
  
  // Benefits/Inclusions (JSON array)
  benefits    String?  @db.Text // JSON: ["10% off food/drink", "parking", "late check-in", "high-speed internet"]
  
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0) // Display order
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  roomType    RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  bookings    Booking[]
  
  @@index([roomTypeId])
  @@index([isActive])
}

// ==========================
// BOOKING
// ==========================

model Booking {
  id            String        @id @default(uuid())
  propertyId    String
  customerId    String
  roomTypeId    String?       // Link to room type
  packageId     String?       // Link to selected package

  checkIn       DateTime
  checkOut      DateTime
  guests        Int
  roomCount     Int           @default(1) // Number of rooms booked

  // Guest Details (booking.com style)
  guestFullName String        // Primary guest name
  guestEmail    String        // Contact email
  guestPhone    String?       // Contact phone
  
  // Arrival & Preferences
  arrivalTime   String?       // Expected arrival time
  specialRequests String?     @db.Text // Special requests from guest
  
  // Purpose of visit (optional)
  visitPurpose  String?       // "business", "leisure", etc.

  subtotal      Decimal
  extraCharges  Decimal       @default(0)
  totalAmount   Decimal
  currency      String

  status        BookingStatus @default(PENDING)

  // Cancellation policy
  cancellationDeadline DateTime?
  cancellationReason   String?
  refundAmount        Decimal?

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  property      Property      @relation(fields: [propertyId], references: [id])
  customer      User          @relation(fields: [customerId], references: [id])
  roomType      RoomType?     @relation(fields: [roomTypeId], references: [id])
  package       RoomPackage?  @relation(fields: [packageId], references: [id])
  payment       Payment?
  invoice       Invoice?
  review        Review?

  @@index([propertyId])
  @@index([customerId])
  @@index([roomTypeId])
  @@index([packageId])
  @@index([status])
  @@index([checkIn, checkOut]) // For availability queries
  @@index([createdAt]) // For auto-cancel cron job
}

// ==========================
// PAYMENTS
// ==========================

model Payment {
  id                String        @id @default(uuid())
  bookingId         String        @unique

  provider          String        // stripe, myfatoorah, tap
  providerRef       String        // Stripe PaymentIntent ID
  amount            Decimal
  currency          String
  status            PaymentStatus

  // Stripe Connect split
  stripeConnectId   String?       // acct_xxx of the host's connected account
  platformFee       Decimal?      // Application fee taken by platform
  hostAmount        Decimal?      // Amount that settled to host

  // Refund tracking
  refundId          String?       // Stripe refund ID
  refundReason      String?       // Reason for refund
  refundedAt        DateTime?

  createdAt         DateTime      @default(now())

  booking           Booking       @relation(fields: [bookingId], references: [id])
}

// ==========================
// INVOICES
// ==========================

model Invoice {
  id            String   @id @default(uuid())
  bookingId     String   @unique

  invoiceNumber String   @unique
  subtotal      Decimal
  taxAmount     Decimal
  totalAmount   Decimal
  currency      String

  pdfUrl        String
  issuedAt      DateTime @default(now())

  booking       Booking  @relation(fields: [bookingId], references: [id])

  @@index([bookingId])
  @@index([issuedAt])
}

// ==========================
// SUBSCRIPTIONS (HOST)
// ==========================

model Subscription {
  id         String             @id @default(uuid())
  hostId     String

  planName   String
  startsAt   DateTime
  endsAt     DateTime
  status     SubscriptionStatus @default(ACTIVE)

  // Limits based on plan
  maxListings        Int @default(1)
  commissionRate     Decimal @default(10) // Platform fee %

  // Payment tracking
  paymentId          String?
  paymentProvider    String?

  // Optional per-booking platform tech fee (on top of monthly subscription)
  techFeePerBooking  Decimal?      @default(0)

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  host       User     @relation(fields: [hostId], references: [id])

  @@index([hostId])
  @@index([status])
  @@index([endsAt]) // For subscription expiry cron job
}

// ==========================
// AMENITIES (for filtering)
// ==========================

model Amenity {
  id          String            @id @default(uuid())
  name        String            @unique
  nameAr      String
  icon        String            // Icon name for UI
  category    String            // wifi, parking, pool, etc.

  properties  PropertyAmenity[]
}

model PropertyAmenity {
  id         String   @id @default(uuid())
  propertyId String
  amenityId  String

  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  amenity    Amenity  @relation(fields: [amenityId], references: [id])

  @@unique([propertyId, amenityId])
  @@index([propertyId])
}

// ==========================
// REVIEWS (Essential for trust)
// ==========================

model Review {
  id         String   @id @default(uuid())
  propertyId String
  customerId String
  bookingId  String   @unique

  rating     Int      // 1-5
  comment    String?
  
  // Host response
  hostResponse String?
  respondedAt  DateTime?

  createdAt  DateTime @default(now())

  property   Property @relation(fields: [propertyId], references: [id])
  customer   User     @relation(fields: [customerId], references: [id])
  booking    Booking  @relation(fields: [bookingId], references: [id])

  @@index([propertyId])
  @@index([customerId])
}

// ==========================
// BLOCKED DATES (Host management)
// ==========================

model BlockedDate {
  id         String   @id @default(uuid())
  propertyId String
  startDate  DateTime
  endDate    DateTime
  reason     String?  // maintenance, personal use, etc.

  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([startDate, endDate])
}

// ==========================
// WISHLIST
// ==========================

model Wishlist {
  id         String   @id @default(uuid())
  userId     String
  propertyId String

  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([userId, propertyId])
  @@index([userId])
  @@index([propertyId])
}

// ==========================
// HOST PAYOUT & STRIPE CONNECT
// ==========================

// Legal and banking details for each host (sub-merchant)
model HostPayout {
  id                   String   @id @default(uuid())
  hostId               String   @unique

  // Legal / business identity
  legalName            String                    // Registered business / full name
  taxId                String?                   // GST / VAT / PAN / Civil ID
  businessType         String   @default("individual") // individual, company

  // Bank account
  bankName             String?
  accountHolderName    String?
  accountNumber        String?                   // IBAN / account number (masked in UI)
  routingCode          String?                   // SWIFT / BIC / sort code

  // Stripe Connect
  stripeConnectId      String?  @unique          // acct_xxx
  onboardingStatus     String   @default("PENDING")  // PENDING | IN_PROGRESS | COMPLETE | RESTRICTED
  chargesEnabled       Boolean  @default(false)  // Can accept payments
  payoutsEnabled       Boolean  @default(false)  // Can receive payouts
  detailsSubmitted     Boolean  @default(false)  // Stripe form completed

  // Platform fee override for this host (null = use subscription default)
  platformFeePercent   Decimal? // e.g., 10.00 = 10%

  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  host                 User     @relation(fields: [hostId], references: [id], onDelete: Cascade)

  @@index([stripeConnectId])
  @@index([onboardingStatus])
}

// ==========================
// WEBHOOK LOG (Idempotency & Reconciliation)
// ==========================

model WebhookLog {
  id            String    @id @default(uuid())
  provider      String    // stripe
  eventId       String    @unique  // Stripe event ID — prevents double-processing
  eventType     String
  payload       String    @db.Text // Raw JSON body
  status        String    @default("RECEIVED") // RECEIVED | PROCESSED | FAILED
  error         String?   @db.Text
  processedAt   DateTime?

  createdAt     DateTime  @default(now())

  @@index([provider, eventId])
  @@index([status])
  @@index([createdAt])
}

// ==========================
// AUDIT LOG (Admin & compliance)
// ==========================

model AuditLog {
  id         String   @id @default(uuid())
  userId     String
  action     String   // PROPERTY_APPROVED, USER_BLOCKED, etc.
  entityType String   // Property, User, Booking
  entityId   String
  metadata   String?  @db.Text // JSON string
  ipAddress  String?

  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

// ==========================
// PLATFORM SETTINGS (Kill-switches)
// ==========================

model PlatformSettings {
  id                   String   @id @default("default")
  
  // Kill-switches
  bookingsEnabled      Boolean  @default(true)
  paymentsEnabled      Boolean  @default(true)
  newPropertiesEnabled Boolean  @default(true)
  
  // Metadata
  updatedAt            DateTime @updatedAt
  updatedBy            String?
}
